# Kun for `npm run test:e2e:skriving` (pre-cutover 3): samme emulator-oppsett
# som .env.test. Byggmodusen «e2e-skriving» slår på forsoningsporten i bygget
# (se src/hooks/forsoningAktivering.ts). "demo-"-prosjektet kan aldri nå
# produksjon; appen peker bare mot den lokale emulatoren.

VITE_FIREBASE_USE_EMULATOR=true
VITE_FIREBASE_PROJECT_ID=demo-familieapp
VITE_FIREBASE_DATABASE_URL=http://127.0.0.1:9000/?ns=demo-familieapp-default-rtdb
VITE_FIREBASE_API_KEY=demo-key
VITE_FIREBASE_AUTH_DOMAIN=demo-familieapp.firebaseapp.com
VITE_FIREBASE_STORAGE_BUCKET=demo-familieapp.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=0
VITE_FIREBASE_APP_ID=demo-app-id
