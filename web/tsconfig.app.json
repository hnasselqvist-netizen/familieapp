{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "types": ["vite/client"],
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Strict — låst arkitekturbeslutning, ikke løsnet "for nå" */
    "strict": true,
    "noUncheckedIndexedAccess": true,

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,

    /* Modulgrenser — matcher mappestrukturen i src/, se eslint.config.js for håndheving.
       Ingen baseUrl (fjernet i TS 6 sin anbefalte oppsett) — paths er relative til denne filen. */
    "paths": {
      "@domain/*": ["./src/domain/*"],
      "@generators/*": ["./src/generators/*"],
      "@data/*": ["./src/data/*"],
      "@hooks/*": ["./src/hooks/*"],
      "@features/*": ["./src/features/*"],
      "@components/*": ["./src/components/*"],
      "@styles/*": ["./src/styles/*"],
      "@app-types/*": ["./src/types/*"]
    }
  },
  "include": ["src"],
  "exclude": ["src/**/*.integration.test.ts"]
}
