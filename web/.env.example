# Kopier til .env.local (git-ignorert) og fyll inn ekte verdier for lokal
# utvikling mot det ekte Firebase-prosjektet. For vanlig lokal utvikling og
# alle tester holder det å sette VITE_FIREBASE_USE_EMULATOR=true — da brukes
# Firebase Emulator Suite, og resten av variablene kan stå tomme.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=familieapp-a5d15
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# "true" = koble til lokal Firebase Emulator Suite (127.0.0.1) i stedet for
# det ekte prosjektet. Alltid "true" i CI og for `npm run dev` lokalt.
VITE_FIREBASE_USE_EMULATOR=true

# Satt kun av preview-workflowen i CI — ikke sett lokalt.
# VITE_DEPLOY_TARGET=preview
