# Brukt automatisk av Vitest (mode "test") for datalag-/integrasjonstester.
# "demo-"-prefikset er en Firebase-dokumentert konvensjon: SDK-en og CLI-en
# nekter å behandle et "demo-"-prosjekt som ekte, selv ved en feilkonfigurert
# emulator-tilkobling. Commitet med vilje — inneholder ingen hemmeligheter,
# kun emulator-adresser.
#
# VIKTIG: namespace i DATABASE_URL må være "<project-id>-default-rtdb", ikke
# bare project-id-en. `firebase.json` sitt "singleProjectMode: true" binder
# RTDB-emulatoren (og reglene den faktisk håndhever) til dette navnet når den
# startes med `--project demo-familieapp` — en klient som ber om et annet
# namespace (f.eks. bare "demo-familieapp") får stille et helt ANNET,
# regelløst skygge-namespace i samme emulator-prosess. Oppdaget i praksis
# via §Kontrolltårn-review sin non-member-denial-test: den bestod bare fordi
# testen (uten dette) traff skyggenavnet, ikke det virkelige, regelstyrte.
VITE_FIREBASE_USE_EMULATOR=true
VITE_FIREBASE_PROJECT_ID=demo-familieapp
VITE_FIREBASE_DATABASE_URL=http://127.0.0.1:9000/?ns=demo-familieapp-default-rtdb
VITE_FIREBASE_API_KEY=demo-key
VITE_FIREBASE_AUTH_DOMAIN=demo-familieapp.firebaseapp.com
VITE_FIREBASE_STORAGE_BUCKET=demo-familieapp.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=0
VITE_FIREBASE_APP_ID=demo-app-id
