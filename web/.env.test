# Brukt automatisk av Vitest (mode "test") for datalag-/integrasjonstester.
# "demo-"-prefikset er en Firebase-dokumentert konvensjon: SDK-en og CLI-en
# nekter å behandle et "demo-"-prosjekt som ekte, selv ved en feilkonfigurert
# emulator-tilkobling. Commitet med vilje — inneholder ingen hemmeligheter,
# kun emulator-adresser.
VITE_FIREBASE_USE_EMULATOR=true
VITE_FIREBASE_PROJECT_ID=demo-familieapp
VITE_FIREBASE_DATABASE_URL=http://127.0.0.1:9000/?ns=demo-familieapp
VITE_FIREBASE_API_KEY=demo-key
VITE_FIREBASE_AUTH_DOMAIN=demo-familieapp.firebaseapp.com
VITE_FIREBASE_STORAGE_BUCKET=demo-familieapp.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=0
VITE_FIREBASE_APP_ID=demo-app-id
