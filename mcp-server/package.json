{
  "name": "hverdagsflyt-mcp-server",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Kontrolltårnets MCP-kontrollflate mot Hverdagsflyt (Issue #27). Foundation: Handleliste-verktøy, auth-kontrakt, idempotens. Ikke deployet.",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "build": "esbuild src/main.ts --bundle --platform=node --target=node22 --format=esm --packages=external --outfile=dist/main.js",
    "build:admin": "esbuild src/admin/linkPrincipal.ts --bundle --platform=node --target=node22 --format=esm --packages=external --outfile=dist/link-principal.js && esbuild src/admin/addMember.ts --bundle --platform=node --target=node22 --format=esm --packages=external --outfile=dist/add-member.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:integration": "firebase emulators:exec --config ../firebase.json --project demo-familieapp --only database,auth \"vitest run --config vitest.integration.config.ts\""
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0",
    "firebase-admin": "^14.5.0",
    "jose": "^6.2.12",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^24.19.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "firebase-tools": "^15.32.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  }
}
